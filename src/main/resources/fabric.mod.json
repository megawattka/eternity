{
    "schemaVersion": 1,
    "id": "eternity",
    "version": "${version}",
    "name": "eternity",
    "description": "Eternity is a simple skyblock QOL mod. Ytka sack dick",
    "authors": ["glsa"],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/megawattka/eternity"
    },
    "license": "CC0-1.0",
    "icon": "assets/eternity/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "org.mgwt.eternity.Eternity",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "eternity.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": "~26.2",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    },
    "accessWidener": "eternity.accesswidener"
}